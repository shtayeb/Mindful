<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pause_point_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--  Background  -->
    <View
        android:id="@+id/pause_point_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical">

        <!-- Bottom Sheet -->
        <LinearLayout
            android:id="@+id/pause_point_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/shape_rounded_top_lg"
            android:backgroundTint="@color/tertiaryContainer"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp">

            <!--  Sheet handle  -->
            <View
                android:layout_width="48dp"
                android:layout_height="6dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="8dp"
                android:background="@drawable/shape_rounded_sm"
                android:backgroundTint="@color/primaryContainer" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <!--  Main card  -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_rounded_md"
                    android:backgroundTint="@color/secondaryContainer"
                    android:orientation="vertical">

                    <!--  Header row  -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!--  App icon  -->
                        <ImageView
                            android:id="@+id/pause_point_app_icon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/shape_rounded_sm"
                            android:clipToOutline="true"
                            android:contentDescription="@string/app_name"
                            android:padding="0dp"
                            android:src="@mipmap/ic_launcher"
                            tools:ignore="UnusedAttribute" />

                        <!--  App info column  -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp">

                            <!--  App name  -->
                            <TextView
                                android:id="@+id/pause_point_app_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/app_name"
                                android:textColor="@color/textPrimary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <!--  Restriction label  -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/app_paused_restriction_pause_point"
                                android:textColor="@color/textSecondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/primaryContainer" />

                    <!--  Prompt  -->
                    <TextView
                        android:id="@+id/pause_point_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="20dp"
                        android:text="@string/pause_point_overlay_prompt"
                        android:textColor="@color/textPrimary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!--  Subprompt  -->
                    <TextView
                        android:id="@+id/pause_point_subprompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="16dp"
                        android:text="@string/pause_point_overlay_subprompt"
                        android:textColor="@color/textSecondary"
                        android:textSize="14sp" />

                    <!--  Countdown  -->
                    <TextView
                        android:id="@+id/pause_point_countdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="24dp"
                        android:text="10"
                        android:textColor="@color/accent"
                        android:textSize="72sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!--  Post-countdown actions  -->
                <LinearLayout
                    android:id="@+id/pause_point_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!--  Open app button  -->
                    <Button
                        android:id="@+id/pause_point_btn_open"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/shape_rounded_md"
                        android:backgroundTint="@color/accent"
                        android:text="@string/pause_point_overlay_btn_open"
                        android:textAllCaps="false"
                        android:textColor="@color/secondaryContainer" />

                    <!--  Return home button  -->
                    <Button
                        android:id="@+id/pause_point_btn_home"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/shape_rounded_md"
                        android:backgroundTint="@color/primaryContainer"
                        android:text="@string/pause_point_overlay_btn_home"
                        android:textAllCaps="false"
                        android:textColor="@color/textPrimary" />
                </LinearLayout>

                <!--  Bottom spacer  -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="32dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
